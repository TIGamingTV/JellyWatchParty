# ============================================================================
# JellyWatchParty - Environment Configuration
# ============================================================================
# Copy this file to .env and adjust values as needed.
# All variables have sensible defaults and are optional.
# ============================================================================

# ----------------------------------------------------------------------------
# Network Ports
# ----------------------------------------------------------------------------

# Jellyfin web UI port (default: 8096)
JELLYFIN_PORT=8096

# WebSocket session server port (default: 3000)
SESSION_SERVER_PORT=3000

# Admin panel port on the host (default: 3001)
ADMIN_PANEL_PORT=3001

# ----------------------------------------------------------------------------
# Media Configuration
# ----------------------------------------------------------------------------

# Path to your media directory (Movies)
# Default: ~/Videos/Movies
MEDIA_DIR=${HOME}/Videos/Movies

# ----------------------------------------------------------------------------
# Session Server
# ----------------------------------------------------------------------------

# Bind address for the session server (default: 0.0.0.0)
# HOST=0.0.0.0

# Internal port for the session server (default: 3000)
# PORT=3000

# Comma-separated list of allowed CORS origins
# Must match your Jellyfin URL(s) for WebSocket connections to work
ALLOWED_ORIGINS=http://localhost:8096,https://localhost:8096

# ----------------------------------------------------------------------------
# Authentication (Optional)
# ----------------------------------------------------------------------------

# JWT secret for session authentication
# Leave empty to disable authentication (development only!)
# For production, use a strong random string (min 32 characters)
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Note: the token lifetime is a plugin setting (Dashboard > Plugins >
# JellyWatchParty > Token TTL), not a session server variable.

# ----------------------------------------------------------------------------
# Admin Panel
# ----------------------------------------------------------------------------
# A web UI on its own port to watch rooms, create password-protected groups,
# add people to them and change hosts. On by default, but it only starts once
# ADMIN_PASSWORD is set. All admins share this one account.

# Set to false to switch the admin panel off completely
# ADMIN_ENABLED=true

# Login. Use a long random password: openssl rand -base64 18
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Or read the password from a file (Docker secrets)
# ADMIN_PASSWORD_FILE=/run/secrets/jwp_admin_password

# Port inside the container (default: 3001). Publish it with ADMIN_PANEL_PORT.
# ADMIN_PORT=3001

# How long a login stays valid, in seconds (default: 43200 = 12 hours)
# ADMIN_SESSION_TTL_SECS=43200

# Set to true when the panel is served over HTTPS (reverse proxy), so the
# login cookie is only ever sent over HTTPS
# ADMIN_COOKIE_SECURE=false

# Behind a reverse proxy, set to true so failed-login throttling sees each
# visitor's address (the last X-Forwarded-For entry) instead of the proxy's.
# Leave false if the panel is reachable without the proxy.
# ADMIN_TRUST_X_FORWARDED_FOR=false

# Groups created in the panel that nobody joins are removed after this many
# seconds (default: 600)
# ADMIN_EMPTY_GROUP_TTL_SECS=600

# Log level for the session server (error, warn, info, debug)
# RUST_LOG=info

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------

# Disable colored output in Makefile (set to any value to disable)
# NO_COLOR=1

# User/Group IDs for Docker volume permissions (auto-detected)
# UID=1000
# GID=1000
