# ============================================================================
# JellyWatchParty - Environment Configuration
# ============================================================================
# Copy this file to .env next to the compose file you use
# (infra/docker/dev or infra/docker/prod) and adjust values as needed.
# Full reference: https://tigamingtv.github.io/JellyWatchParty/configuration/
# ============================================================================

# ----------------------------------------------------------------------------
# Network Ports
# ----------------------------------------------------------------------------

# Jellyfin web UI port (default: 8096)
JELLYFIN_PORT=8096

# WebSocket session server port (default: 3000)
SESSION_SERVER_PORT=3000

# Admin panel port on the host (default: 3001)
ADMIN_PANEL_PORT=3001

# ----------------------------------------------------------------------------
# Media Configuration
# ----------------------------------------------------------------------------

# Path to your media directory (Movies)
# Default: ~/Videos/Movies
MEDIA_DIR=${HOME}/Videos/Movies

# ----------------------------------------------------------------------------
# Session Server
# ----------------------------------------------------------------------------

# Bind address for the session server (default: 0.0.0.0)
# HOST=0.0.0.0

# Internal port for the session server (default: 3000)
# PORT=3000

# Comma-separated list of the exact addresses users open Jellyfin at
# (scheme://host:port, no trailing slash). Browser WebSocket connections
# from other origins are refused.
ALLOWED_ORIGINS=http://localhost:8096,https://localhost:8096

# ----------------------------------------------------------------------------
# Authentication (Optional)
# ----------------------------------------------------------------------------

# JWT secret for session authentication. Must be the same value as the
# plugin's "JWT Secret" (Dashboard > Plugins > JellyWatchParty).
# Leave empty to disable authentication (development only!)
# For production, use a strong random string (min 32 characters)
# Generate one with: openssl rand -base64 32
JWT_SECRET=
# Must match the plugin's JWT Audience / JWT Issuer (defaults shown)
# JWT_AUDIENCE=JellyWatchParty
# JWT_ISSUER=Jellyfin

# Note: the token lifetime is a plugin setting (Dashboard > Plugins >
# JellyWatchParty > Token TTL), not a session server variable.

# ----------------------------------------------------------------------------
# Admin Panel
# ----------------------------------------------------------------------------
# A web UI on its own port to watch rooms, create password-protected groups,
# add people to them and change hosts. On by default, but it only starts once
# ADMIN_PASSWORD is set. All admins share this one account.

# Set to false to switch the admin panel off completely
# ADMIN_ENABLED=true

# Login. Use a long random password: openssl rand -base64 18
# Write values without quotes; only a $ must be doubled ($$).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Or read them from files (Docker secrets). A variable above wins over its
# file. Files are re-read while the server runs: changing one applies within
# 10 seconds and signs everyone out. A change to ADMIN_USERNAME or
# ADMIN_PASSWORD needs the container recreated (docker compose up -d), not
# just restarted.
# ADMIN_PASSWORD_FILE=/run/secrets/jwp_admin_password
# ADMIN_USERNAME_FILE=/run/secrets/jwp_admin_username

# Port inside the container (default: 3001). Publish it with ADMIN_PANEL_PORT.
# ADMIN_PORT=3001

# How long a login stays valid, in seconds (default: 43200 = 12 hours)
# ADMIN_SESSION_TTL_SECS=43200

# Set to true when the panel is served over HTTPS (reverse proxy), so the
# login cookie is only ever sent over HTTPS
# ADMIN_COOKIE_SECURE=false

# Behind a reverse proxy, set to true so failed-login throttling sees each
# visitor's address (the last X-Forwarded-For entry) instead of the proxy's.
# Leave false if the panel is reachable without the proxy.
# ADMIN_TRUST_X_FORWARDED_FOR=false

# Groups created in the panel that nobody joins are removed after this many
# seconds (default: 600)
# ADMIN_EMPTY_GROUP_TTL_SECS=600

# --- Jellyfin devices (optional) ---
# Lets the admin panel put Jellyfin clients that can't show the Watch Party
# panel (Android TV, Fladder, Swiftfin, Infuse, ...) into rooms, as host or
# receiver. The session server drives them over the Jellyfin API.
#
# URL of your Jellyfin server as seen from the session server container
# (e.g. http://jellyfin:8096 on a shared Docker network)
# JELLYFIN_URL=http://jellyfin:8096
# API key: Jellyfin Dashboard > API Keys > + (name it "JellyWatchParty").
# It has admin rights on Jellyfin - keep it secret.
# JELLYFIN_API_KEY=
# JELLYFIN_API_KEY_FILE=/run/secrets/jellyfin_api_key
# How often to read device positions from Jellyfin, in ms (default: 1000)
# BRIDGE_POLL_INTERVAL_MS=1000

# --- Chat bots: Discord and/or Telegram (optional) ---
# Let people run watch parties for their own Jellyfin devices from Discord
# or a Telegram group, without an admin. Need the admin panel and the
# Jellyfin devices settings above. Everything else (server or group,
# channels, roles, limits, link codes) is set in the admin panel. See
# docs/discord-bot.md and docs/telegram-bot.md. Both run in one container.
#
# The compose files keep link codes and settings in the jwp-data volume
# (DATA_DIR=/data). Outside Docker, set DATA_DIR to a private directory.
# DATA_DIR=/var/lib/jellywatchparty
#
# Shared secret between the session server and the bot container, one per
# platform, each different (at least 32 characters): openssl rand -hex 32
# DISCORD_INTEGRATION_TOKEN=
# TELEGRAM_INTEGRATION_TOKEN=
# The bots' tokens. Discord: Developer Portal > your application > Bot >
# Reset Token. Telegram: @BotFather > /newbot.
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=
# Port of the integration API inside the Docker network (default: 3002).
# Never publish it.
# INTEGRATION_PORT=3002
# Start the bot with: docker compose --profile discord up -d
# (or --profile telegram; either starts the same container)

# Log level for the session server (error, warn, info, debug)
# RUST_LOG=info

# ----------------------------------------------------------------------------
# Images (infra/docker/prod)
# ----------------------------------------------------------------------------

# Image tag for the session server and the chat bot: latest (last release,
# default), a release version such as 4.1.5.0 (from v4.1.5.0 on), beta (last
# build of main) or dev (last build of develop).
# JWP_TAG=latest

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------

# User/Group IDs for Docker volume permissions (auto-detected)
# UID=1000
# GID=1000
