<Project>
  <!--
    Jellyfin 10.11.x support has been dropped - the plugin now targets only
    Jellyfin 12.x (stable, released 2026-09-08). Users still on 10.11.x
    should install an older JellyWatchParty release (targetAbi 10.11.11.0)
    instead.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <JellyfinPackageVersion>12.0.0</JellyfinPackageVersion>
    <JellyfinTargetAbi>12.0.0.0</JellyfinTargetAbi>
  </PropertyGroup>
</Project>
